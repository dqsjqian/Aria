# Doxyfile.in — configured by CMake (ARIA_BUILD_DOCS=ON) into
# ${CMAKE_BINARY_DIR}/Doxyfile. Generates the public API reference for
# Aria (ROADMAP P1-F). Run via the `aria_docs` target:
#
#     cmake -B build/flavors/docs -DARIA_BUILD_DOCS=ON
#     cmake --build build/flavors/docs --target aria_docs
#     open build/flavors/docs/docs/html/index.html
#
# Doxygen is invoked with WORKING_DIRECTORY = the project source root, so
# all INPUT / EXCLUDE paths below are relative to that root.

PROJECT_NAME           = "Aria"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Modern C++20 MVVM framework — reactive, coroutine-first, ABI-layered"
OUTPUT_DIRECTORY       = @ARIA_DOCS_OUTPUT_DIR@

# ── Inputs ───────────────────────────────────────────────────────────────
# Public headers of every shipped module + the prose docs. Implementation
# folders (detail/, src/, tests/, fuzz/) and vendored code are excluded so
# the reference is the *public surface only*.
INPUT                  = modules \
                         docs \
                         README.md \
                         README.en.md \
                         CHANGELOG.md
USE_MDFILE_AS_MAINPAGE = README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.inl *.md
EXTENSION_MAPPING      = inl=C++
INPUT_FILTER           = "\"@Python3_EXECUTABLE@\" \"@CMAKE_CURRENT_SOURCE_DIR@/scripts/filter-docs.py\" --revision \"@ARIA_DOCS_SOURCE_REVISION@\" --repository \"@ARIA_DOCS_REPOSITORY_URL@\""

EXCLUDE_PATTERNS       = */detail/* \
                         */tests/* \
                         */fuzz/* \
                         */src/* \
                         */build/* \
                         */third_party/*
# Hide internal implementation namespaces from the reference even when a
# public header pulls them in transitively.
EXCLUDE_SYMBOLS        = aria::detail aria::detail::* \
                         aria::abi::detail aria::abi::detail::* \
                         aria::reactive::detail aria::reactive::detail::* \
                         aria::async::detail aria::async::detail::* \
                         aria::binding::detail aria::binding::detail::* \
                         aria::adapters::qt6::detail aria::adapters::qt6::detail::* \
                         AriaClickTarget AriaToggleTarget AriaStepperTarget \
                         AriaSliderTarget AriaTextDelegate AriaTableDataSource \
                         AriaUIClickTarget AriaUIToggleTarget AriaUIStepperTarget \
                         AriaUISliderTarget AriaUITextTarget AriaUITableDataSource

# ── Extraction policy: public, documented surface ─────────────────────────
# Index public declarations even when they have no Doxygen comment. Ordinary
# `//` blocks remain source comments; only Doxygen comment syntax contributes
# prose to the generated symbol descriptions.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3

# ── C++20 / preprocessor ───────────────────────────────────────────────────
# Neutralise the export-macro decorations so the parser sees clean
# declarations regardless of the build configuration.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = ARIA_CORE_API= \
                         ARIA_ABI_API= \
                         ARIA_RUNTIME_API= \
                         ARIA_BINDING_API= \
                         ARIA_QT6_API= \
                         ARIA_JNI_API= \
                         ARIA_HTTP_API= \
                         ARIA_PLUGIN_EXPORT= \
                         "ARIA_NODISCARD=[[nodiscard]]" \
                         __cplusplus=202002L

# ── Output ─────────────────────────────────────────────────────────────────
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

# ── Diagrams (optional; only if Graphviz/dot is available) ─────────────────
HAVE_DOT               = @ARIA_DOXYGEN_HAVE_DOT@
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO

# ── Warnings ───────────────────────────────────────────────────────────────
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO

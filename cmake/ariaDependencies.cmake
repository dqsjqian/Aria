# Aria policy and compatibility names; ForgeDeps owns dependency resolution.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ariaFindQt.cmake")

foreach(_aria_dep JSON DOCTEST MIRA OPENSSL)
    set(ARIA_DEP_${_aria_dep}_VERSION "" CACHE STRING "Explicit ${_aria_dep} version (empty: use dependencies.json)")
endforeach()
unset(_aria_dep)
option(ARIA_DEPENDENCIES_OFFLINE "Require locked dependency metadata and cached downloads" OFF)
set(ARIA_DEPENDENCIES_FILE "" CACHE FILEPATH "Consumer dependencies.json (empty: Aria's file)")
set(FORGEDEPS_CMAKE_DIR "" CACHE PATH "ForgeDeps CMake directory (empty: discover with Python)")
set(FORGEDEPS_PYTHON_EXECUTABLE "$ENV{FORGEDEPS_PYTHON_EXECUTABLE}" CACHE FILEPATH "Python with the pinned forgedeps package")

# Load lazily: a core-only build with tests disabled has no managed sources.
macro(_aria_load_deps)
    if(FORGEDEPS_PYTHON_EXECUTABLE)
        set(ForgeDeps_PYTHON_EXECUTABLE "${FORGEDEPS_PYTHON_EXECUTABLE}")
    endif()
    if(NOT COMMAND forgedeps_resolve)
        set(_aria_bridge "${FORGEDEPS_CMAKE_DIR}")
        if(NOT _aria_bridge)
            if(NOT ForgeDeps_PYTHON_EXECUTABLE)
                find_package(Python3 3.10 QUIET COMPONENTS Interpreter)
                if(NOT Python3_Interpreter_FOUND)
                    message(FATAL_ERROR "Aria dependencies require Python 3.10+ and forgedeps; install requirements-build.txt")
                endif()
                set(ForgeDeps_PYTHON_EXECUTABLE "${Python3_EXECUTABLE}")
                set(FORGEDEPS_PYTHON_EXECUTABLE "${Python3_EXECUTABLE}" CACHE FILEPATH
                    "Python with the pinned forgedeps package" FORCE)
            endif()
            execute_process(COMMAND "${ForgeDeps_PYTHON_EXECUTABLE}" -m forgedeps cmake-dir
                RESULT_VARIABLE _aria_result OUTPUT_VARIABLE _aria_bridge ERROR_VARIABLE _aria_error
                OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(NOT _aria_result EQUAL 0)
                message(FATAL_ERROR "Cannot load ForgeDeps; install requirements-build.txt with ${ForgeDeps_PYTHON_EXECUTABLE}:\n${_aria_error}")
            endif()
        endif()
        if(NOT EXISTS "${_aria_bridge}/ForgeDeps.cmake")
            message(FATAL_ERROR "ForgeDeps CMake bridge not found: ${_aria_bridge}/ForgeDeps.cmake")
        endif()
        include("${_aria_bridge}/ForgeDeps.cmake")
    endif()
endmacro()

function(aria_resolve_dependency)
    cmake_parse_arguments(DEP "" "NAME;VERSION;URL;SHA256;REVISION;TAG;FILE" "" ${ARGN})
    if(NOT DEP_NAME OR DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "aria_resolve_dependency: expected NAME and output-variable arguments")
    endif()
    if(NOT DEP_FILE)
        set(DEP_FILE "${ARIA_DEPENDENCIES_FILE}")
    endif()
    if(NOT DEP_FILE)
        set(DEP_FILE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../dependencies.json")
    endif()
    string(TOUPPER "${DEP_NAME}" _upper)
    set(_arguments NAME "${DEP_NAME}" FILE "${DEP_FILE}")
    if(ARIA_DEP_${_upper}_VERSION)
        list(APPEND _arguments REQUEST_VERSION "${ARIA_DEP_${_upper}_VERSION}")
    endif()
    if(ARIA_DEPENDENCIES_OFFLINE)
        list(APPEND _arguments OFFLINE)
    endif()
    foreach(_field VERSION URL SHA256 REVISION TAG)
        if(DEP_${_field})
            list(APPEND _arguments ${_field} _aria_value_${_field})
        endif()
    endforeach()
    _aria_load_deps()
    forgedeps_resolve(${_arguments})
    foreach(_field VERSION URL SHA256 REVISION TAG)
        if(DEP_${_field})
            set(${DEP_${_field}} "${_aria_value_${_field}}" PARENT_SCOPE)
        endif()
    endforeach()
endfunction()

# Qt is an installed SDK, not a downloaded source dependency. Keep CMake's
# prefix/Qt6_DIR selection explicit and prefer newer visible version folders.
include_guard(GLOBAL)
set(ARIA_DEP_QT_VERSION "" CACHE STRING "Exact installed Qt6 version (empty: newest visible candidate)")

macro(aria_find_qt6)
    set(_aria_qt_order_defined FALSE)
    set(_aria_qt_direction_defined FALSE)
    if(DEFINED CMAKE_FIND_PACKAGE_SORT_ORDER)
        set(_aria_qt_order_defined TRUE)
    endif()
    if(DEFINED CMAKE_FIND_PACKAGE_SORT_DIRECTION)
        set(_aria_qt_direction_defined TRUE)
    endif()
    set(_aria_qt_sort_order "${CMAKE_FIND_PACKAGE_SORT_ORDER}")
    set(_aria_qt_sort_direction "${CMAKE_FIND_PACKAGE_SORT_DIRECTION}")
    # Qt's EntryPointPrivate config creates its imported target unconditionally,
    # so a second find_package(Qt6) in the same configure aborts with
    # "add_library cannot create imported target EntryPointMinGW32 because
    # another target with the same name already exists". A caller that already
    # found the requested components therefore needs no second search.
    set(_aria_qt_components "")
    set(_aria_qt_collect FALSE)
    foreach(_aria_qt_argument IN ITEMS ${ARGN})
        if(_aria_qt_argument STREQUAL "COMPONENTS")
            set(_aria_qt_collect TRUE)
        elseif(_aria_qt_collect)
            list(APPEND _aria_qt_components "${_aria_qt_argument}")
        endif()
    endforeach()
    set(_aria_qt_already_found TRUE)
    foreach(_aria_qt_component IN LISTS _aria_qt_components)
        if(NOT TARGET Qt6::${_aria_qt_component})
            set(_aria_qt_already_found FALSE)
        endif()
    endforeach()
    if(NOT (_aria_qt_components AND _aria_qt_already_found))
    set(CMAKE_FIND_PACKAGE_SORT_ORDER NATURAL)
    set(CMAKE_FIND_PACKAGE_SORT_DIRECTION DEC)
    if(ARIA_DEP_QT_VERSION)
        find_package(Qt6 "${ARIA_DEP_QT_VERSION}" EXACT ${ARGN})
    else()
        find_package(Qt6 ${ARGN})
    endif()
    if(_aria_qt_order_defined)
        set(CMAKE_FIND_PACKAGE_SORT_ORDER "${_aria_qt_sort_order}")
    else()
        unset(CMAKE_FIND_PACKAGE_SORT_ORDER)
    endif()
    if(_aria_qt_direction_defined)
        set(CMAKE_FIND_PACKAGE_SORT_DIRECTION "${_aria_qt_sort_direction}")
    else()
        unset(CMAKE_FIND_PACKAGE_SORT_DIRECTION)
    endif()
    unset(_aria_qt_sort_order)
    unset(_aria_qt_sort_direction)
    unset(_aria_qt_order_defined)
    unset(_aria_qt_direction_defined)
    endif()
    unset(_aria_qt_components)
    unset(_aria_qt_collect)
    unset(_aria_qt_already_found)
endmacro()

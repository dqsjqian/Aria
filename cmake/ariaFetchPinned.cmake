# Compatibility wrapper: ForgeDeps owns downloads and verified source caches.
# Explicit ARIA_PIN_<NAME>_SOURCE_DIR remains a trusted, unverified local tree.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ariaDependencies.cmake")

function(_forgedeps_cache_dir out)
    if(FORGEDEPS_CACHE_DIR)
        set(_cache "${FORGEDEPS_CACHE_DIR}")
    elseif(IS_DIRECTORY "${CMAKE_SOURCE_DIR}/build")
        set(_cache "${CMAKE_SOURCE_DIR}/build/_deps")
    else()
        set(_cache "${CMAKE_BINARY_DIR}/_deps")
    endif()
    set(${out} "${_cache}" PARENT_SCOPE)
endfunction()

function(aria_fetch_pinned_archive)
    cmake_parse_arguments(PIN "" "NAME;VERSION;URL;SHA256" "" ${ARGN})
    if(NOT PIN_NAME OR PIN_UNPARSED_ARGUMENTS OR PIN_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "aria_fetch_pinned_archive: expected NAME and complete metadata")
    endif()
    string(TOUPPER "${PIN_NAME}" _upper)
    set(_override "ARIA_PIN_${_upper}_SOURCE_DIR")
    if(${_override})
        if(NOT IS_DIRECTORY "${${_override}}")
            message(FATAL_ERROR "Aria deps: ${_override} is not a source directory: ${${_override}}")
        endif()
        set(ARIA_PINNED_${_upper}_SOURCE_DIR "${${_override}}" PARENT_SCOPE)
        message(STATUS "Aria deps: ${PIN_NAME} from override ${${_override}} (not verified)")
        return()
    endif()
    if(NOT PIN_VERSION AND NOT PIN_URL AND NOT PIN_SHA256)
        aria_resolve_dependency(NAME "${PIN_NAME}" VERSION PIN_VERSION URL PIN_URL SHA256 PIN_SHA256)
    endif()
    _forgedeps_cache_dir(_cache)
    set(_arguments NAME "${PIN_NAME}" VERSION "${PIN_VERSION}" URL "${PIN_URL}"
        SHA256 "${PIN_SHA256}" CACHE "${_cache}" SOURCE_DIR _source)
    if(ARIA_DEPENDENCIES_OFFLINE)
        list(APPEND _arguments OFFLINE)
    endif()
    _aria_load_deps()
    forgedeps_fetch_archive(${_arguments})
    set(ARIA_PINNED_${_upper}_SOURCE_DIR "${_source}" PARENT_SCOPE)
endfunction()

function(aria_fetch_pinned_file)
    cmake_parse_arguments(PIN "" "NAME;URL;SHA256;AS" "" ${ARGN})
    if(NOT PIN_NAME OR PIN_UNPARSED_ARGUMENTS OR PIN_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "aria_fetch_pinned_file: expected NAME and complete metadata")
    endif()
    if(NOT PIN_URL AND NOT PIN_SHA256)
        aria_resolve_dependency(NAME "${PIN_NAME}" URL PIN_URL SHA256 PIN_SHA256)
    endif()
    _forgedeps_cache_dir(_cache)
    set(_arguments NAME "${PIN_NAME}" URL "${PIN_URL}" SHA256 "${PIN_SHA256}"
        CACHE "${_cache}" FILE _file BASE _base)
    if(PIN_AS)
        list(APPEND _arguments AS "${PIN_AS}")
    endif()
    if(ARIA_DEPENDENCIES_OFFLINE)
        list(APPEND _arguments OFFLINE)
    endif()
    _aria_load_deps()
    forgedeps_fetch_file(${_arguments})
    string(TOUPPER "${PIN_NAME}" _upper)
    set(ARIA_PINNED_${_upper}_FILE "${_file}" PARENT_SCOPE)
    set(ARIA_PINNED_${_upper}_BASE "${_base}" PARENT_SCOPE)
endfunction()

# Generated per build tree. CMake 3.20-compatible environment setup; paths and
# compiler flags never depend on cmake -E env --modify (added much later).
if(NOT CONFIG)
    set(CONFIG Release)
endif()
if(NOT CONFIG MATCHES "^[A-Za-z0-9_]+$")
    message(FATAL_ERROR "Unsupported OpenSSL configuration name: ${CONFIG}")
endif()
set(_build "@_OPENSSL_ROOT@/build/${CONFIG}")
set(_install "@_OPENSSL_ROOT@/install/${CONFIG}")
file(MAKE_DIRECTORY "${_build}")
if(CMAKE_HOST_WIN32)
    set(ENV{PATH} "@_OPENSSL_COMPILER_DIR@;@_OPENSSL_NASM_DIR@;$ENV{PATH}")
else()
    set(ENV{PATH} "@_OPENSSL_COMPILER_DIR@:$ENV{PATH}")
endif()
set(ENV{CC} "@_OPENSSL_CC@")
set(ENV{AR} "@_OPENSSL_AR@")
set(ENV{RANLIB} "@_OPENSSL_RANLIB@")
if(NOT "@_OPENSSL_NDK@" STREQUAL "")
    set(ENV{ANDROID_NDK_ROOT} "@_OPENSSL_NDK@")
endif()
set(_flags_DEBUG [==[@CMAKE_C_FLAGS_DEBUG@]==])
set(_flags_RELEASE [==[@CMAKE_C_FLAGS_RELEASE@]==])
set(_flags_RELWITHDEBINFO [==[@CMAKE_C_FLAGS_RELWITHDEBINFO@]==])
set(_flags_MINSIZEREL [==[@CMAKE_C_FLAGS_MINSIZEREL@]==])
string(TOUPPER "${CONFIG}" _upper)
set(_base_flags [==[@CMAKE_C_FLAGS@]==])
set(_extra_flags [==[@_OPENSSL_EXTRA_CFLAGS@]==])
set(ENV{CFLAGS} "${_base_flags} ${_flags_${_upper}} ${_extra_flags}")
set(_args @_OPENSSL_CONFIGURE_ARGS@)
if(CONFIG STREQUAL "Debug")
    list(APPEND _args --debug)
else()
    list(APPEND _args --release)
endif()
if(NOT "@_OPENSSL_BASH@" STREQUAL "")
    execute_process(COMMAND "@_OPENSSL_BASH@" "@_OPENSSL_ROOT@/run-mingw.sh" "${STEP}" "${CONFIG}" ${_args}
        RESULT_VARIABLE _result COMMAND_ECHO STDOUT)
elseif(STEP STREQUAL "configure")
    execute_process(COMMAND "@ARIA_OPENSSL_PERL@" "@OPENSSL_SOURCE_DIR@/Configure" ${_args} "--prefix=${_install}" --libdir=lib
        WORKING_DIRECTORY "${_build}" RESULT_VARIABLE _result COMMAND_ECHO STDOUT)
elseif(STEP STREQUAL "build" OR STEP STREQUAL "install")
    if(STEP STREQUAL "build")
        set(_target build_libs)
    else()
        set(_target install_dev)
    endif()
    set(_jobs "")
    if(NOT "@MSVC@")
        set(_jobs "-j@ARIA_OPENSSL_JOBS@")
    endif()
    execute_process(COMMAND "@ARIA_OPENSSL_MAKE@" ${_jobs} "${_target}"
        WORKING_DIRECTORY "${_build}" RESULT_VARIABLE _result COMMAND_ECHO STDOUT)
else()
    message(FATAL_ERROR "Unknown OpenSSL step: ${STEP}")
endif()
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "OpenSSL ${STEP} failed: ${_result}")
endif()

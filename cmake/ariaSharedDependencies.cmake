# Aria selects dependencies; ForgeDeps and ForgeRecipes own their builds.
include("${CMAKE_CURRENT_LIST_DIR}/ariaDependencies.cmake")
set(ARIA_DEPENDENCIES_CONFIGURATION "" CACHE STRING
    "Shared dependency configuration (required for multi-config generators)")
set(_aria_configuration "${ARIA_DEPENDENCIES_CONFIGURATION}")
if(NOT _aria_configuration)
    set(_aria_configuration "${CMAKE_BUILD_TYPE}")
elseif(CMAKE_BUILD_TYPE AND NOT _aria_configuration STREQUAL CMAKE_BUILD_TYPE)
    message(FATAL_ERROR "ARIA_DEPENDENCIES_CONFIGURATION must match CMAKE_BUILD_TYPE")
endif()
set(_aria_shared_names)
set(_aria_json_license_source "")
set(_aria_json_imported FALSE)
set(_aria_openssl_imported FALSE)
set(_aria_openssl_license_source "")
set(_aria_managed_openssl FALSE)

# Only explicitly supplied prefixes may replace the locked dependency. Do not
# silently select an unrelated system package via CMake's default search paths.
if(ARIA_BUILD_HTTP AND NOT TARGET nlohmann_json::nlohmann_json)
    if(CMAKE_PREFIX_PATH AND NOT ARIA_PIN_JSON_SOURCE_DIR)
        unset(nlohmann_json_DIR CACHE)
        find_package(nlohmann_json CONFIG QUIET PATHS ${CMAKE_PREFIX_PATH} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
        set(_aria_json_imported TRUE)
    endif()
    if(NOT TARGET nlohmann_json::nlohmann_json)
        list(APPEND _aria_shared_names json)
    endif()
endif()
if(ARIA_BUILD_TESTS AND NOT TARGET doctest::doctest)
    if(CMAKE_PREFIX_PATH AND NOT ARIA_PIN_DOCTEST_SOURCE_DIR)
        unset(doctest_DIR CACHE)
        find_package(doctest CONFIG QUIET PATHS ${CMAKE_PREFIX_PATH} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    endif()
    if(NOT TARGET doctest::doctest)
        list(APPEND _aria_shared_names doctest)
    endif()
endif()
if(ARIA_BUILD_HTTP AND ARIA_HTTP_ENABLE_TLS)
    include("${CMAKE_CURRENT_LIST_DIR}/ariaParentOpenSSL.cmake")
    if(NOT TARGET OpenSSL::SSL)
        if(CMAKE_PREFIX_PATH AND NOT ARIA_PIN_OPENSSL_SOURCE_DIR)
            unset(OpenSSL_DIR CACHE)
            find_package(OpenSSL CONFIG QUIET PATHS ${CMAKE_PREFIX_PATH} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
            set(_aria_openssl_imported TRUE)
        endif()
        if(NOT TARGET OpenSSL::SSL)
            # Probe the actual C compiler, including C-only flags and SDK state.
            enable_language(C)
            list(APPEND _aria_shared_names openssl)
            set(_aria_managed_openssl TRUE)
        endif()
    endif()
endif()

if(_aria_shared_names)
    _aria_load_deps()
    if(NOT COMMAND forgedeps_environment)
        message(FATAL_ERROR "Aria requires ForgeDeps 0.4+; install requirements-build.txt")
    endif()
    set(_aria_lock "${ARIA_DEPENDENCIES_FILE}")
    if(NOT _aria_lock)
        set(_aria_lock "${CMAKE_CURRENT_LIST_DIR}/../dependencies.json")
    endif()
    get_filename_component(_aria_lock "${_aria_lock}" ABSOLUTE)
    set(_aria_effective "${CMAKE_CURRENT_BINARY_DIR}/aria-shared-dependencies.json")
    set(_aria_resolve resolve --file "${_aria_lock}" --output "${_aria_effective}"
        --cache "${CMAKE_CURRENT_BINARY_DIR}/_forgedeps/resolver")
    set(_aria_source_overrides)
    foreach(_name IN LISTS _aria_shared_names)
        string(TOUPPER "${_name}" _upper)
        list(APPEND _aria_resolve --only "${_name}")
        if(ARIA_DEP_${_upper}_VERSION)
            list(APPEND _aria_resolve --version "${_name}=${ARIA_DEP_${_upper}_VERSION}")
        endif()
        if(ARIA_PIN_${_upper}_SOURCE_DIR)
            list(APPEND _aria_source_overrides "${_name}=${ARIA_PIN_${_upper}_SOURCE_DIR}")
        endif()
    endforeach()
    set(_aria_offline)
    if(ARIA_DEPENDENCIES_OFFLINE)
        list(APPEND _aria_resolve --offline)
        set(_aria_offline OFFLINE)
    endif()
    _forgedeps_run(_aria_resolution ${_aria_resolve})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_aria_lock}" "${_aria_effective}")
    list(JOIN _aria_shared_names "," _aria_only)
    if(_aria_source_overrides)
        list(PREPEND _aria_source_overrides SOURCE_OVERRIDES)
    endif()
    forgedeps_environment(FILE "${_aria_effective}"
        PROJECT_CONFIG "${CMAKE_CURRENT_LIST_DIR}/../scripts/dependency_config.py"
        ONLY "${_aria_only}" CONFIGURATION "${_aria_configuration}"
        OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/forgedeps-environment.json"
        PREFIXES _aria_shared_prefixes ${_aria_source_overrides} ${_aria_offline})
    foreach(_name IN LISTS _aria_shared_names)
        if(_name STREQUAL "json")
            unset(nlohmann_json_DIR CACHE)
            find_package(nlohmann_json CONFIG REQUIRED PATHS ${_aria_shared_prefixes} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
            set(_aria_json_imported TRUE)
        elseif(_name STREQUAL "doctest")
            unset(doctest_DIR CACHE)
            find_package(doctest CONFIG REQUIRED PATHS ${_aria_shared_prefixes} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
        elseif(_name STREQUAL "openssl")
            unset(OpenSSL_DIR CACHE)
            find_package(OpenSSL CONFIG REQUIRED PATHS ${_aria_shared_prefixes} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
            set(_aria_openssl_imported TRUE)
        endif()
    endforeach()
endif()

# Licenses follow the package actually selected, never an arbitrary cache copy.
# Explicit parent targets may provide ARIA_<NAME>_LICENSE_FILE instead.
foreach(_prefix IN LISTS CMAKE_PREFIX_PATH)
    if(_aria_json_imported AND nlohmann_json_DIR AND IS_DIRECTORY "${_prefix}/share/licenses/json")
        cmake_path(IS_PREFIX _prefix "${nlohmann_json_DIR}" NORMALIZE _aria_match)
        if(_aria_match)
            set(_aria_json_license_source "${_prefix}/share/licenses/json")
            set(_aria_json_attributions "${_prefix}/share/licenses/json/ATTRIBUTIONS.txt")
        endif()
    endif()
    if(_aria_openssl_imported AND OpenSSL_DIR)
        cmake_path(IS_PREFIX _prefix "${OpenSSL_DIR}" NORMALIZE _aria_match)
        if(_aria_match AND IS_DIRECTORY "${_prefix}/share/licenses/openssl")
            set(ARIA_BUNDLED_OPENSSL "${_aria_managed_openssl}")
            set(OPENSSL_INSTALL_DIR "${_prefix}")
            set(OPENSSL_SOURCE_DIR "${_prefix}/share/licenses/openssl")
            set(_aria_openssl_license_source "${OPENSSL_SOURCE_DIR}")
            get_filename_component(_OPENSSL_SSL_NAME "${OPENSSL_SSL_LIBRARY}" NAME)
            get_filename_component(_OPENSSL_CRYPTO_NAME "${OPENSSL_CRYPTO_LIBRARY}" NAME)
        endif()
    endif()
endforeach()
